#!/bin/bash

hacerbackup() {
  clear
  echo "Haciendo copia de seguridad..."
  cd /etc/DTunnel || exit 1
  mkdir -p painelbackup > /dev/null 2>&1
  cp prisma/database.db painelbackup/ 2>/dev/null
  cp .env painelbackup/ 2>/dev/null
  zip -r painelbackup.zip painelbackup > /dev/null 2>&1
  mv painelbackup.zip /root/ 2>/dev/null
  echo
  echo "painelbackup.zip guardado en /root"
  echo
  read -rp "Presione Enter para continuar..."
  pmenu
}

autobackup() {
  clear
  read -rp "¿Desea activar el Auto Backup? (s/n) " atb
  [[ $atb =~ ^[sS]$ ]] && {
    echo "Activando...."
    backmod
    echo
    echo "¡Copia de seguridad cada 5 horas activa!"
    sleep 3
    pmenu
  }
  pmenu
}

removerpanel() {
  clear
  read -rp "¿Desea eliminar el panel? (s/n) " rev
  [[ $rev =~ ^[sS]$ ]] && {
    echo "Eliminando..."
    poff 2>/dev/null
    pm2 delete PrismaStudio 2>/dev/null
    rm -f /bin/pon /bin/poff /bin/pmenu /bin/backmod /bin/pupdate 2>/dev/null
    rm -rf /etc/DTunnel
    echo "¡Eliminado con éxito!"
    exit 0
  }
  pmenu
}

restaurarbackup() {
  clear
  if [[ ! -e /root/painelbackup.zip ]]; then
    echo "Archivo painelbackup.zip no encontrado en /root"
    sleep 3
    pmenu
  fi
  read -rp "¿Desea Restaurar la Copia de Seguridad? (s/n) " rapi
  if [[ $rapi =~ ^[sS]$ ]]; then
    echo "Restaurando..."
    cd /etc/DTunnel || exit 1
    rm -f prisma/database.db .env
    cd /root || exit 1
    unzip -o painelbackup.zip > /dev/null 2>&1
    cp painelbackup/database.db /etc/DTunnel/prisma/ 2>/dev/null
    cp painelbackup/.env /etc/DTunnel/ 2>/dev/null
    rm -rf /root/painelbackup
    pon
    echo
    echo "¡Copia de seguridad restaurada con éxito!"
    sleep 3
    pmenu
  fi
  pmenu
}

actualizarpanel() {
  clear
  echo "=========================================="
  echo "      ACTUALIZANDO PANEL DTUNNEL          "
  echo "=========================================="
  echo
  if command -v pupdate >/dev/null 2>&1; then
    pupdate
  else
    echo "Ejecutando actualización directa..."
    cd /etc/DTunnel || exit 1
    git fetch --all && git reset --hard origin/main
    npx tsc || true
    pm2 restart ecosystem.config.js 2>/dev/null || pm2 start ecosystem.config.js
    pm2 restart PrismaStudio 2>/dev/null || pm2 start "npx prisma studio --port 5656 --hostname 0.0.0.0 --browser none" --name PrismaStudio
    systemctl restart haproxy 2>/dev/null
    echo
    echo "¡Actualización completada!"
  fi
  read -rp "Presione Enter para continuar..."
  pmenu
}

pmenu() {
  clear
  echo "=========================================="
  echo "      BIENVENIDO/A AL PANEL DTUNNEL       "
  echo "=========================================="
  echo 
  echo " 1. Encender panel"
  echo " 2. Reiniciar panel"
  echo " 3. Apagar panel"
  echo " 4. Hacer copia de seguridad"
  echo " 5. Restaurar copia de seguridad"
  echo " 6. Activar Auto backup"
  echo " 7. 🔄 Actualizar panel (pupdate)"
  echo " 8. Eliminar panel"
  echo " 0. Salir"
  echo "=========================================="
  read -rp "> " resp

  case $resp in
    1)
      pon
      echo "¡Encendido con éxito!"
      sleep 3
      pmenu
      ;;
    2)
      clear
      pon
      pm2 restart PrismaStudio 2>/dev/null
      systemctl restart haproxy 2>/dev/null
      echo "¡Reiniciado con éxito!"
      sleep 3
      pmenu
      ;;
    3)
      clear
      poff
      pm2 stop PrismaStudio 2>/dev/null
      echo "¡Apagado con éxito!"
      sleep 3
      pmenu
      ;;
    4)
      hacerbackup
      ;;
    5)
      restaurarbackup
      ;;
    6)
      autobackup
      ;;
    7)
      actualizarpanel
      ;;
    8)
      removerpanel
      ;;
    0)
      echo "Saliendo..."
      clear
      exit 0
      ;;
    *)
      echo "¡Opción inválida!"
      sleep 2
      pmenu
      ;;
  esac
}

pmenu
