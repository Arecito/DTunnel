#!/bin/bash

# Verificar permisos de Root
if [[ "$EUID" -ne 0 ]]; then
  echo "¡Debe ejecutar la actualización como usuario Root!"
  exit 1
fi

clear
echo "=========================================="
echo "    ACTUALIZANDO PANEL DTUNNEL           "
echo "=========================================="
echo

cd /etc/DTunnel || exit 1

echo "[1/4] Descargando últimos cambios desde GitHub..."
git fetch --all
git reset --hard origin/main

echo "[2/4] Actualizando permisos y comandos de sistema..."
chmod +x pon poff pmenu backmod pupdate 2>/dev/null
cp pon poff pmenu backmod pupdate /bin/ 2>/dev/null
chmod +x /bin/pon /bin/poff /bin/pmenu /bin/backmod /bin/pupdate 2>/dev/null

echo "[3/4] Recompilando proyecto TypeScript..."
npx tsc || true

echo "[4/4] Reiniciando servicios en PM2 y HAProxy..."
pm2 restart ecosystem.config.js 2>/dev/null || pm2 start ecosystem.config.js
pm2 restart PrismaStudio 2>/dev/null || pm2 start "npx prisma studio --port 5656 --hostname 0.0.0.0 --browser none" --name PrismaStudio
pm2 save 2>/dev/null

if [ -f /etc/haproxy/haproxy.cfg ]; then
  systemctl restart haproxy 2>/dev/null || service haproxy restart 2>/dev/null
fi

echo
echo "=========================================="
echo "   ¡PANEL ACTUALIZADO CORRECTAMENTE!      "
echo "=========================================="
echo
